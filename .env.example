# Server Configuration
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Database (Local Docker or MongoDB Atlas)
# Local Docker: mongodb://localhost:27017/repolens
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/repolens?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/repolens

# GitHub Integration (Optional for public repos, recommended to avoid rate limits: 60/hr -> 5000/hr)
GITHUB_TOKEN=

# Google Gemini AI (Required for Semantic Search embeddings and AI Agent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
